{
  "name": "endgit-core",
  "version": "0.1.0",
  "description": "EndGit API Server — CI/CD + Plugin Marketplace for Endstone",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "export DATABASE_URL=${AZURE_DATABASE_URL:-$DATABASE_URL} && npx prisma@5 generate --schema=packages/database/prisma/schema.prisma && npx prisma@5 db push --schema=packages/database/prisma/schema.prisma --accept-data-loss && tsx src/index.ts",
    "heroku-postbuild": "echo 'Skipping prisma generate in build step to avoid Heroku pruning issues'",
    "db:generate": "pnpm --filter @endgit/database generate",
    "db:push": "pnpm --filter @endgit/database push",
    "db:migrate": "pnpm --filter @endgit/database migrate",
    "db:seed": "pnpm --filter @endgit/database seed",
    "db:studio": "pnpm --filter @endgit/database studio",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "prisma generate --schema=packages/database/prisma/schema.prisma && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express4": "^1.1.2",
    "@endgit/database": "workspace:*",
    "@endgit/storage": "workspace:*",
    "@endgit/types": "workspace:*",
    "bcryptjs": "^2.4.3",
    "body-parser": "^2.2.2",
    "bullmq": "^5.79.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dataloader": "^2.2.3",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "graphql": "^16.14.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.0",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.7",
    "prettier": "^3.8.3",
    "semver": "^7.6.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.1.0",
    "@types/nodemailer": "^8.0.0",
    "@types/semver": "^7.5.8",
    "@vitest/coverage-v8": "^4.1.7",
    "typescript": "^5.6.0",
    "vitest": "^4.1.7"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/two-tech-dev/endgit-core.git"
  }
}
